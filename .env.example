# Copy to .env and fill in. .env is gitignored; this template is safe to commit.
#
# You need two things to run live: a chat model and a search key.
# Both have free tiers that cover casual demo use:
#   GROQ_API_KEY    https://console.groq.com/keys   (free, serves llama-3.1-8b-instant)
#   TAVILY_API_KEY  https://app.tavily.com          (free tier, 1000 credits/month)
#
# With no keys at all the app still runs -- it replays the 650 recorded
# evaluation runs shipped in evaluation/.

# --- search: required for any live run -------------------------------------
TAVILY_API_KEY=tvly-...

# --- model: set the one matching your provider -----------------------------
GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-proj-...
# GOOGLE_API_KEY=AIza...

# --- optional overrides ----------------------------------------------------
# LLM_PROVIDER=groq          # groq | openai | google | ollama (default: auto-detect)
# LLM_MODEL=                 # override the provider's default model
# ACCEPT_THRESHOLD=70        # claim score at or above which an answer is accepted
# OLLAMA_BASE_URL=http://localhost:11434
